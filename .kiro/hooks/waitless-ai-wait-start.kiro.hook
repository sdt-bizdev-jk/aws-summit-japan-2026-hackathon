{
  "enabled": true,
  "name": "WaitLess: AI 待ち開始 (Variant A: 直接コマンド)",
  "description": "プロンプト送信時に WaitLess IDE 拡張機能の startWaiting コマンドを直接呼び出し、外部ブラウザで娯楽サイトを開く (cycle-4)",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/start"
  },
  "workspaceFolderName": "aws-summit-japan-2026-hackathon",
  "shortName": "waitless-ai-wait-start"
}