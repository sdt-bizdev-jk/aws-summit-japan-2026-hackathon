{
  "enabled": true,
  "name": "WaitLess: AI 完了で Kiro に戻る (agentStop)",
  "description": "AI 応答完了時にトリガーファイル (/tmp/waitless-ide-triggers/end) を作成しつつ、osascript で Kiro を直接最前面化する。VS Code 拡張の fs.watch が macOS で時々イベントを取りこぼす問題への対策として、Hook 単独で Kiro 前面化を完結させる (cycle-7)。トリガーファイル touch は Extension 側の PAUSE_MEDIA notify など補助動作のため残す。Claude Code 側 .claude/settings.json の Stop / StopFailure フックと等価 (Kiro は agentStop に正常終了・異常終了の区別がないため両方をカバー)",
  "version": "4",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/end && osascript -e 'tell application \"Kiro\" to activate' && echo \"$(date '+%F %T') KIRO:agentStop -> end (+osascript)\" >> /tmp/waitless-hook.log"
  },
  "workspaceFolderName": "aws-summit-japan-2026-hackathon",
  "shortName": "waitless-ai-wait-end"
}
