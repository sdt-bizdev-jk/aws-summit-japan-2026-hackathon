{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/start && echo \"$(date '+%F %T') CC:UserPromptSubmit -> start\" >> /tmp/waitless-hook.log",
            "async":   true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/start && echo \"$(date '+%F %T') CC:PostToolUse(AskUserQuestion|ExitPlanMode) -> start\" >> /tmp/waitless-hook.log",
            "async":   true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/end && echo \"$(date '+%F %T') CC:Stop -> end\" >> /tmp/waitless-hook.log"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/end && echo \"$(date '+%F %T') CC:StopFailure -> end\" >> /tmp/waitless-hook.log"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type":    "command",
            "command": "input=$(cat); mkdir -p /tmp/waitless-ide-triggers; touch /tmp/waitless-ide-triggers/end; { printf '%s CC:Notification -> end | stdin=' \"$(date '+%F %T')\"; printf '%s\\n' \"$input\"; } >> /tmp/waitless-hook.log"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/end && echo \"$(date '+%F %T') CC:PermissionRequest -> end\" >> /tmp/waitless-hook.log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type":    "command",
            "command": "mkdir -p /tmp/waitless-ide-triggers && touch /tmp/waitless-ide-triggers/end && echo \"$(date '+%F %T') CC:PreToolUse(AskUserQuestion|ExitPlanMode) -> end\" >> /tmp/waitless-hook.log"
          }
        ]
      }
    ]
  }
}
