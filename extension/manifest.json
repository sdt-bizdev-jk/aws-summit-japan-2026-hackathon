{
  "manifest_version": 3,
  "name": "WaitLess",
  "version": "0.9.0",
  "description": "生成AIの待ち時間を、登録した娯楽サイトへの自動切替で快適に。Claude.aiの応答待ちに加え、Kiro IDE と連携して、IDE での AI 待ち時間にも動画・ゲーム・SNS・EC・ストレッチ瞑想・読書 (内蔵)・娯楽ポータル (内蔵) などを楽しめます。待ち時間や余暇種別の統計をダッシュボード (内蔵) で確認できます。",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude_site_adapter.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WaitLess — 待ち時間を有効活用 (クリックで設定)"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "reader/reader.html",
        "reader/reader.css",
        "reader/reader.js",
        "reader/novel.txt",
        "portal/portal.html",
        "portal/portal.css",
        "portal/portal.js",
        "portal/portal_data.js",
        "dashboard/dashboard.html",
        "dashboard/dashboard.css",
        "dashboard/dashboard.js",
        "dashboard/stats_aggregator.js",
        "player/player.html",
        "player/player.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
